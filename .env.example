# Encrypts local Posthouse state. Required for Docker and other headless runs.
POSTHOUSE_CACHE_KEY=replace-with-a-base64-or-hex-encoded-32-byte-key

# Protects HTTP MCP + REST. Generate with: posthouse setup
POSTHOUSE_ACCESS_KEY=replace-with-a-long-random-access-key

# Optional alias for POSTHOUSE_ACCESS_KEY. If both are set they must match.
# POSTHOUSE_MCP_TOKEN=

# Optional bind address. Default is 127.0.0.1:8791, or 127.0.0.1:$PORT when PORT is set.
# POSTHOUSE_HTTP_ADDRESS=127.0.0.1:8791

# Set to 1 to allow cleartext non-loopback binding (same as --allow-container-listener).
# POSTHOUSE_ALLOW_CONTAINER_LISTENER=1

# Set to 1 when a TLS reverse proxy forwards X-Real-IP / X-Forwarded-For (Railway, Caddy, nginx).
# POSTHOUSE_TRUST_PROXY=1

# Provider secrets referenced from /data/config.json (names are examples).
ACME_MAIL_PASSWORD=replace-with-an-app-password
ACME_CALENDAR_PASSWORD=replace-with-an-app-password
